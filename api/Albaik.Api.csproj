<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>Albaik.Api</RootNamespace>
  </PropertyGroup>

  <!-- The brand mark embedded in printed QR codes; read from the app directory at runtime. -->
  <ItemGroup>
    <None Update="Assets\crown-navy.webp" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <!-- The email logo is embedded so every deployment and test run has it without a wwwroot. -->
  <ItemGroup>
    <EmbeddedResource Include="Assets\email-logo-white.png" />
  </ItemGroup>

  <!--
    The integration test suite lives under tests/ and the one-off importer lives under
    Albaik.Importer/; neither may compile into the running API.
  -->
  <ItemGroup>
    <Compile Remove="tests/**" />
    <Content Remove="tests/**" />
    <None Remove="tests/**" />
    <Compile Remove="Albaik.Importer/**" />
    <Content Remove="Albaik.Importer/**" />
    <None Remove="Albaik.Importer/**" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="10.0.12" />
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="10.0.12" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="9.0.0">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="Pomelo.EntityFrameworkCore.MySql" Version="9.0.0" />
    <PackageReference Include="MailKit" Version="4.18.0" />
    <PackageReference Include="BCrypt.Net-Next" Version="4.2.1" />
    <PackageReference Include="QRCoder" Version="1.8.1" />
    <!--
      Image pipeline for product photography. MIT licensed (unlike ImageSharp,
      whose Six Labors Split License has a commercial revenue clause that would
      apply here). Used by ImagePipeline to transcode every upload to WebP under
      a hard byte ceiling.

      Deployment note: the managed assembly needs the native Skia binary for the
      target RID. Win32 comes in transitively; a Linux host must add
      `SkiaSharp.NativeAssets.Linux` explicitly or every upload will throw
      DllNotFoundException at runtime.
    -->
    <PackageReference Include="SkiaSharp" Version="4.152.1" />
    <!--
      Transitive (MailKit / JwtBearer). Pinned forward because the 10.0.0 build carries
      a high-severity advisory (GHSA-846f-f764-76mx) and a moderate one
      (GHSA-2fmv-rv2c-59x7). Without this the publish output ships the vulnerable copy.
    -->
    <PackageReference Include="System.Security.Cryptography.Pkcs" Version="10.0.14" />
  </ItemGroup>

</Project>
