<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>Albaik.Api</RootNamespace>
  </PropertyGroup>

  <!-- The integration test suite lives under tests/ but must never compile into the API. -->
  <ItemGroup>
    <Compile Remove="tests/**" />
    <Content Remove="tests/**" />
    <None Remove="tests/**" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="10.0.12" />
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="10.0.12" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.12">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" Version="10.0.12" />
    <PackageReference Include="MailKit" Version="4.18.0" />
    <PackageReference Include="BCrypt.Net-Next" Version="4.2.1" />
    <!--
      Image pipeline for product photography. MIT licensed (unlike ImageSharp,
      whose Six Labors Split License has a commercial revenue clause that would
      apply here). Used by ImagePipeline to transcode every upload to WebP under
      a hard byte ceiling.

      Deployment note: the managed assembly needs the native Skia binary for the
      target RID. Win32 comes in transitively; a Linux host must add
      `SkiaSharp.NativeAssets.Linux` explicitly or every upload will throw
      DllNotFoundException at runtime.
    -->
    <PackageReference Include="SkiaSharp" Version="4.152.1" />
  </ItemGroup>

</Project>
